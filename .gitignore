# =========================
# 1. 前端依赖与编译缓存 (VitePress)
# =========================
# Node.js 依赖文件夹（绝对不能传）
node_modules/

# VitePress 编译生成的临时文件和缓存
docs/.vitepress/dist/
docs/.vitepress/cache/

# VitePress 加载 config 时 esbuild 生成的临时打包产物
docs/.vitepress/*.timestamp-*.mjs

# =========================
# 2. 动态 UI 状态缓存 (Obsidian)
# =========================
# 忽略 Obsidian 那些每次点击都会变的动态状态文件
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/lean-terminal/data.json
markdown-states.json

# 仅忽略 Draw.io 插件的庞大离线引擎包，保留用户配置(data.json)
.obsidian/plugins/drawio/webapp/

# =========================
# 3. 系统与环境文件
# =========================
# 系统生成的隐藏文件 (Mac / Windows)
.DS_Store
Thumbs.db

# 本地环境变量文件 (如果有)
.env
.env.*.local

# =========================
# 4. 测试目录
# =========================
test/

# =========================
# 忽略 Draw.io 临时备份文件
# =========================
*.$*.bkp
*.bkp
.obsidian/plugins/obsidian-quiet-outline/

# =========================
# 5. 保留 VitePress 目录
# =========================
!.vitepress

# =========================
# 6. 导读页 index.md（构建产物，不入库）
# =========================
# 各目录的 index.md 由 scripts/auto-index.mjs 在构建前整文件重新生成，
# 云端（ESA `npm run docs:build`）与本地 `npm run docs:dev/build` 都会重建；
# 唯一手写、必须保留的是根目录首页 docs/index.md（故加 ! 反忽略）。
docs/**/index.md
!docs/index.md

# =========================
# 7. 本地 Obsidian 用的 attachments junction
# =========================
# 仓库根的 attachments/ 是指向 docs/public/attachments 的目录联接（mklink /J），
# 只为让 Obsidian 能解析笔记里的 /attachments/... 绝对链接（否则点击会补建空笔记）。
# 它不属于源码，必须整目录忽略，否则 git 会顺着 junction 把附件当重复文件跟踪。
# 注意：必须带前导 / 锚定仓库根，否则会连 docs/public/attachments 一起忽略。
/attachments/