# =========================
# 1. 前端依赖与编译缓存 (VitePress)
# =========================
# Node.js 依赖文件夹（绝对不能传）
node_modules/

# VitePress 编译生成的临时文件和缓存
docs/.vitepress/dist/
docs/.vitepress/cache/

# =========================
# 2. 动态 UI 状态缓存 (Obsidian)
# =========================
# 忽略 Obsidian 那些每次点击都会变的动态状态文件
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/lean-terminal/data.json

# =========================
# 3. 系统与环境文件
# =========================
# 系统生成的隐藏文件 (Mac / Windows)
.DS_Store
Thumbs.db

# 本地环境变量文件 (如果有)
.env
.env.*.local

# =========================
# 4. 测试目录
# =========================
test/