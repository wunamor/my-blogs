{
  "biggerIcons": "mobile",
  "clickableIcons": "on",
  "showAllFileIcons": true,
  "showAllFolderIcons": false,
  "minimalFolderIcons": true,
  "showMarkdownTabIcons": true,
  "showTitleIcons": true,
  "showTagPillIcons": false,
  "showMenuActions": true,
  "showSuggestionIcons": false,
  "showQuickSwitcherIcons": true,
  "showMoveFileIcons": true,
  "showItemName": "desktop",
  "useSearchKeywords": "on",
  "maxSearchResults": 100,
  "colorPicker1": "list",
  "colorPicker2": "rgb",
  "uncolorHover": false,
  "uncolorDrag": false,
  "uncolorSelect": false,
  "uncolorQuick": false,
  "maxBackups": 2,
  "dialogState": {
    "iconMode": true,
    "emojiMode": false,
    "rulePage": "folder"
  },
  "appIcons": {},
  "tabIcons": {},
  "fileIcons": {
    "package.json": {
      "icon": "lucide-braces"
    }
  },
  "bookmarkIcons": {},
  "tagIcons": {},
  "propertyIcons": {},
  "ribbonIcons": {},
  "fileRules": [
    {
      "id": "REs1N",
      "name": "JSON",
      "match": "all",
      "conditions": [
        {
          "source": "extension",
          "operator": "endsWith",
          "value": "json"
        }
      ],
      "enabled": true,
      "icon": "lucide-file-braces",
      "color": "gray"
    },
    {
      "id": "iNldR",
      "name": "无标题规则",
      "match": "all",
      "conditions": [
        {
          "source": "name",
          "operator": "contains"
        }
      ],
      "enabled": true
    }
  ],
  "folderRules": [
    {
      "id": "dlr7Q",
      "name": "默认格式",
      "match": "all",
      "conditions": [
        {
          "source": "tree",
          "operator": "is"
        }
      ],
      "enabled": true
    }
  ]
}