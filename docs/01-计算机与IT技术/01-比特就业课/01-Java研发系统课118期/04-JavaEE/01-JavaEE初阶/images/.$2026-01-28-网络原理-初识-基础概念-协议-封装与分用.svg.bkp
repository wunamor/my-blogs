        <mxCell id="info_head" value="核心工作机制说明：" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#E2E8F0;fontStyle=1" vertex="1" parent="1">
