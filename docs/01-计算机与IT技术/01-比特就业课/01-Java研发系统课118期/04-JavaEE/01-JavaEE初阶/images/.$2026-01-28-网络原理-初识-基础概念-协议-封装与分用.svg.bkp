        </mxCell>

        <!-- 说明左列 -->
        <mxCell id="info_left" value="&lt;b style='color:#63B3ED'&gt;➤ 各层架构职责：&lt;/b&gt;&lt;br&gt;&lt;br&gt;5. 应用层：解决业务需求，产生业务数据（如发邮件、发网页）。&lt;br&gt;&lt;br&gt;4. 传输层：解决进程到进程的通信，保证端到端可靠性（常用 TCP/UDP）。&lt;br&gt;&lt;br&gt;3. 网络层：解决主机到主机的跨网络路由寻址（使用 IP 地址）。&lt;br&gt;&lt;br&gt;1-2. 链路与物理层：解决局部/直连网络内的数据传输，进行物理寻址（MAC 地址）与电气信号转换。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#A0AEC0;" vertex="1" parent="1">
          <mxGeometry x="50" y="750" width="700" height="150" as="geometry" />
        </mxCell>

        <!-- 说明右列 -->
        <mxCell id="info_right" value="&lt;b style='color:#63B3ED'&gt;➤ 封装 (Encapsulation) 干了什么？&lt;/b&gt;&lt;br&gt;发生在发送端。数据自上而下传递，每一层都把上一层交下来的数据当做自己的“净荷(Payload)”，&lt;br&gt;并在前面加上自己的控制信息（如IP头、MAC头）。链路层还会为了差错检测额外添加【帧尾(FCS)】。&lt;br&gt;就像寄快递：物品包进纸箱，纸箱贴上快递单，最后装进运输车。&lt;br&gt;&lt;br&gt;&lt;b style='color:#63B3ED'&gt;➤ 分用 (Demultiplexing) 干了什么？&lt;/b&gt;&lt;br&gt;发生在接收端。底层核对控制首部无误后，会将其“剥离”(解封装)，向上层递交。&lt;br&gt;【分用】是指在剥离首部的过程中，系统根据首部里的标识（如网络层的协议号、传输层的端口号），&lt;br&gt;精准地将数据分配给对应的上层协议或对应的应用程序（比如将 80 端口的数据交给 Web 服务器）。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#A0AEC0;" vertex="1" parent="1">
          <mxGeometry x="800" y="750" width="700" height="160" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>