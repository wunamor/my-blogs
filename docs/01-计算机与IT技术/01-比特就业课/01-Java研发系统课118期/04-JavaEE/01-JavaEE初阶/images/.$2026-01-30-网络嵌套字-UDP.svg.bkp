<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" background="#121212" math="0" shadow="1">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- ==================== 标题 ==================== -->
    <mxCell id="title" value="UDP 基本通信逻辑架构图 (无连接状态)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="30" width="400" height="50" as="geometry" />
    </mxCell>

    <!-- ==================== 模块背景框 (防止重叠，绝对坐标) ==================== -->
    <!-- 客户端背景框 (蓝) -->
    <mxCell id="client_box" value="客户端 (Client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3b82f6;strokeWidth=2;fontColor=#60a5fa;verticalAlign=top;spacingTop=15;fontSize=18;fontStyle=1;dashed=0;" vertex="1" parent="1">
      <mxGeometry x="70" y="100" width="280" height="600" as="geometry" />
    </mxCell>

    <!-- 服务端背景框 (绿) -->
    <mxCell id="server_box" value="服务端 (Server)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#10b981;strokeWidth=2;fontColor=#34d399;verticalAlign=top;spacingTop=15;fontSize=18;fontStyle=1;dashed=0;" vertex="1" parent="1">
      <mxGeometry x="750" y="100" width="280" height="600" as="geometry" />
    </mxCell>

    <!-- 网络传输虚线框 (橙) -->
    <mxCell id="network_box" value="Internet / 网络层&#xa;(不可靠数据报传输)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#f59e0b;strokeWidth=2;fontColor=#fcd34d;verticalAlign=top;spacingTop=15;fontSize=16;fontStyle=1;dashed=1;dashPattern=8 8;" vertex="1" parent="1">
      <mxGeometry x="380" y="270" width="340" height="320" as="geometry" />
    </mxCell>


    <!-- ==================== 客户端节点 (X=110) ==================== -->
    <mxCell id="c_socket" value="创建套接字&#xa;socket()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#60a5fa;fontColor=#ffffff;fontStyle=1;shadow=1;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="110" y="160" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="c_sendto" value="发送数据到服务端&#xa;sendto()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#60a5fa;fontColor=#ffffff;fontStyle=1;shadow=1;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="110" y="300" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="c_recvfrom" value="接收服务端响应&#xa;recvfrom() [阻塞等待]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#60a5fa;fontColor=#ffffff;fontStyle=1;shadow=1;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="110" y="500" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="c_close" value="关闭套接字&#xa;close()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#60a5fa;fontColor=#ffffff;fontStyle=1;shadow=1;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="110" y="620" width="200" height="60" as="geometry" />
    </mxCell>


    <!-- ==================== 服务端节点 (X=790) ==================== -->
    <mxCell id="s_socket" value="创建套接字&#xa;socket()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#34d399;fontColor=#ffffff;fontStyle=1;shadow=1;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="790" y="160" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="s_bind" value="绑定IP和端口&#xa;bind()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#34d399;fontColor=#ffffff;fontStyle=1;shadow=1;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="790" y="240" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="s_recvfrom" value="接收客户端请求&#xa;recvfrom() [阻塞等待]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#34d399;fontColor=#ffffff;fontStyle=1;shadow=1;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="790" y="340" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="s_process" value="业务逻辑处理&#xa;(如解析Token, 查询DB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4c1d95;strokeColor=#a78bfa;fontColor=#ffffff;fontStyle=1;shadow=1;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="790" y="420" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="s_sendto" value="发送响应给客户端&#xa;sendto()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#34d399;fontColor=#ffffff;fontStyle=1;shadow=1;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="790" y="500" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="s_close" value="关闭套接字&#xa;close()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#34d399;fontColor=#ffffff;fontStyle=1;shadow=1;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="790" y="620" width="200" height="60" as="geometry" />
    </mxCell>


    <!-- ==================== 客户端内部连线 ==================== -->
    <mxCell id="edge_c1_c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9ca3af;strokeWidth=2;fontColor=#ffffff;" edge="1" parent="1" source="c_socket" target="c_sendto">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="210" y="220" as="sourcePoint" />
        <mxPoint x="210" y="300" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <mxCell id="edge_c2_c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9ca3af;strokeWidth=2;fontColor=#ffffff;" edge="1" parent="1" source="c_sendto" target="c_recvfrom">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="210" y="360" as="sourcePoint" />
        <mxPoint x="210" y="500" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <mxCell id="edge_c3_c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9ca3af;strokeWidth=2;fontColor=#ffffff;" edge="1" parent="1" source="c_recvfrom" target="c_close">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="210" y="560" as="sourcePoint" />
        <mxPoint x="210" y="620" as="targetPoint" />
      </mxGeometry>
    </mxCell>


    <!-- ==================== 服务端内部连线 ==================== -->
    <mxCell id="edge_s1_s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9ca3af;strokeWidth=2;fontColor=#ffffff;" edge="1" parent="1" source="s_socket" target="s_bind">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="890" y="220" as="sourcePoint" />
        <mxPoint x="890" y="240" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <mxCell id="edge_s2_s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9ca3af;strokeWidth=2;fontColor=#ffffff;" edge="1" parent="1" source="s_bind" target="s_recvfrom">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="890" y="300" as="sourcePoint" />
        <mxPoint x="890" y="340" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <mxCell id="edge_s3_s4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9ca3af;strokeWidth=2;fontColor=#ffffff;" edge="1" parent="1" source="s_recvfrom" target="s_process">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="890" y="400" as="sourcePoint" />
        <mxPoint x="890" y="420" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <mxCell id="edge_s4_s5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9ca3af;strokeWidth=2;fontColor=#ffffff;" edge="1" parent="1" source="s_process" target="s_sendto">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="890" y="480" as="sourcePoint" />
        <mxPoint x="890" y="500" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <mxCell id="edge_s5_s6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9ca3af;strokeWidth=2;fontColor=#ffffff;" edge="1" parent="1" source="s_sendto" target="s_close">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="890" y="560" as="sourcePoint" />
        <mxPoint x="890" y="620" as="targetPoint" />
      </mxGeometry>
    </mxCell>


    <!-- ==================== 跨网络通信连线 (UDP请求与响应) ==================== -->
    <!-- 客户端发送请求到服务端 -->
    <mxCell id="edge_net_req" value="1. UDP Datagram (发送请求)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f59e0b;strokeWidth=3;fontColor=#fcd34d;dashed=1;fontSize=14;fontStyle=1;labelBackgroundColor=#121212;" edge="1" parent="1" source="c_sendto" target="s_recvfrom">
      <mxGeometry x="-0.0208" y="10" relative="1" as="geometry">
        <mxPoint x="310" y="330" as="sourcePoint" />
        <mxPoint x="790" y="370" as="targetPoint" />
        <mxPoint as="offset" />
        <Array as="points">
          <mxPoint x="550" y="330" />
          <mxPoint x="550" y="370" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- 服务端发送响应到客户端 -->
    <mxCell id="edge_net_res" value="2. UDP Datagram (返回响应)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f59e0b;strokeWidth=3;fontColor=#fcd34d;dashed=1;fontSize=14;fontStyle=1;labelBackgroundColor=#121212;" edge="1" parent="1" source="s_sendto" target="c_recvfrom">
      <mxGeometry x="-0.0208" y="-10" relative="1" as="geometry">
        <mxPoint x="790" y="530" as="sourcePoint" />
        <mxPoint x="310" y="530" as="targetPoint" />
        <mxPoint as="offset" />
      </mxGeometry>
    </mxCell>


    <!-- ==================== 细节与说明标注 ==================== -->
    <mxCell id="note_noconn" value="【架构师注】：UDP 是无连接、不可靠的传输协议。&#xa;图中没有类似 TCP 的三次握手建立连接过程。&#xa;客户端直接发送数据报向目标IP和端口投递。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#333333;strokeColor=#555555;fontColor=#e5e7eb;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="70" y="720" width="400" height="60" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>