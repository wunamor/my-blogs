<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" background="#121212" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- ==================== 标题 ==================== -->
    <mxCell id="title" value="TCP 拥塞控制算法 (Tahoe vs Reno)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#e5e7eb;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="30" width="500" height="50" as="geometry" />
    </mxCell>

    <!-- ==================== 图例 (Legend) - 已右移避免重叠 ==================== -->
    <mxCell id="legend_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#374151;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="150" y="80" width="280" height="170" as="geometry" />
    </mxCell>
    
    <mxCell id="leg1_line" style="edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=3;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="100" as="sourcePoint" /><mxPoint x="210" y="100" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="leg1_text" value="慢启动 (指数增长)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#d1d5db;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="90" width="130" height="20" as="geometry" /></mxCell>

    <mxCell id="leg2_line" style="edgeStyle=none;html=1;strokeColor=#34d399;strokeWidth=3;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="125" as="sourcePoint" /><mxPoint x="210" y="125" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="leg2_text" value="拥塞避免 (线性增长)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#d1d5db;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="115" width="130" height="20" as="geometry" /></mxCell>

    <mxCell id="leg3_line" style="edgeStyle=none;html=1;strokeColor=#34d399;strokeWidth=3;endArrow=classic;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="150" as="sourcePoint" /><mxPoint x="210" y="150" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="leg3_text" value="Reno 机制: 快速恢复" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#d1d5db;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="140" width="200" height="20" as="geometry" /></mxCell>

    <mxCell id="leg4_line" style="edgeStyle=none;html=1;strokeColor=#a855f7;strokeWidth=3;dashed=1;endArrow=classic;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="175" as="sourcePoint" /><mxPoint x="210" y="175" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="leg4_text" value="Tahoe 机制 (已废弃): 跌至 1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#c4b5fd;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="165" width="200" height="20" as="geometry" /></mxCell>

    <mxCell id="leg5_line" style="edgeStyle=none;html=1;strokeColor=#fcd34d;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="200" as="sourcePoint" /><mxPoint x="210" y="200" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="leg5_text" value="慢启动阈值 (ssthresh)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#d1d5db;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="190" width="140" height="20" as="geometry" /></mxCell>

    <mxCell id="leg6_line" style="edgeStyle=none;html=1;strokeColor=#ef4444;strokeWidth=2;dashed=1;endArrow=classic;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="225" as="sourcePoint" /><mxPoint x="210" y="225" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="leg6_text" value="网络超时 (Timeout)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#d1d5db;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="215" width="140" height="20" as="geometry" /></mxCell>

    <!-- ==================== 坐标系与网格 ==================== -->
    <mxCell id="axis_x" style="edgeStyle=none;html=1;strokeColor=#6b7280;strokeWidth=2;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="100" y="600" as="sourcePoint" />
        <mxPoint x="1150" y="600" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="label_x" value="传输轮次 (Transmission Round) →" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#9ca3af;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="900" y="610" width="240" height="20" as="geometry" />
    </mxCell>

    <mxCell id="axis_y" style="edgeStyle=none;html=1;strokeColor=#6b7280;strokeWidth=2;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="100" y="600" as="sourcePoint" />
        <mxPoint x="100" y="180" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    
    <!-- Y轴标签 (已下移避免与图例重叠) -->
    <mxCell id="label_y" value="拥塞窗口大小&#xa;(cwnd) ↑" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#9ca3af;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="5" y="190" width="90" height="40" as="geometry" />
    </mxCell>

    <!-- 辅助网格线与 Y 轴刻度 -->
    <mxCell id="grid_24" style="edgeStyle=none;html=1;strokeColor=#374151;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="240" as="sourcePoint" /><mxPoint x="1120" y="240" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="tick_24" value="24" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#9ca3af;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="30" height="20" as="geometry" /></mxCell>

    <mxCell id="grid_16" style="edgeStyle=none;html=1;strokeColor=#374151;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="360" as="sourcePoint" /><mxPoint x="1120" y="360" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="tick_16" value="16" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#9ca3af;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="30" height="20" as="geometry" /></mxCell>

    <mxCell id="grid_12" style="edgeStyle=none;html=1;strokeColor=#374151;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="420" as="sourcePoint" /><mxPoint x="1120" y="420" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="tick_12" value="12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#9ca3af;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="30" height="20" as="geometry" /></mxCell>

    <mxCell id="grid_8" style="edgeStyle=none;html=1;strokeColor=#374151;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="480" as="sourcePoint" /><mxPoint x="1120" y="480" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="tick_8" value="8" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#9ca3af;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="30" height="20" as="geometry" /></mxCell>

    <mxCell id="tick_1" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#9ca3af;" vertex="1" parent="1"><mxGeometry x="60" y="575" width="30" height="20" as="geometry" /></mxCell>


    <!-- ==================== 核心折线图 ==================== -->

    <!-- ssthresh1 = 16 -->
    <mxCell id="ssthresh1" style="edgeStyle=none;html=1;strokeColor=#fcd34d;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="360" as="sourcePoint" /><mxPoint x="650" y="360" as="targetPoint" /></mxGeometry></mxCell>

    <!-- 1. 慢启动 1 -->
    <mxCell id="line_ss1" style="edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=3;endArrow=none;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="100" y="585" as="sourcePoint" />
        <mxPoint x="300" y="360" as="targetPoint" />
        <Array as="points"><mxPoint x="150" y="570" /><mxPoint x="200" y="540" /><mxPoint x="250" y="480" /></Array>
      </mxGeometry>
    </mxCell>
    
    <!-- 2. 拥塞避免 1 -->
    <mxCell id="line_ca1" style="edgeStyle=none;html=1;strokeColor=#34d399;strokeWidth=3;endArrow=none;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="360" as="sourcePoint" /><mxPoint x="650" y="240" as="targetPoint" /></mxGeometry>
    </mxCell>

    <!-- 3. 超时 (Timeout) -->
    <mxCell id="line_drop1" style="edgeStyle=none;html=1;strokeColor=#ef4444;strokeWidth=2;dashed=1;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="650" y="240" as="sourcePoint" /><mxPoint x="650" y="585" as="targetPoint" /></mxGeometry>
    </mxCell>
    <mxCell id="label_drop1" value="超时 (丢包)&#xa;ssthresh = cwnd / 2&#xa;cwnd 重置为 1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#fca5a5;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="660" y="240" width="130" height="50" as="geometry" />
    </mxCell>

    <!-- ssthresh2 = 12 -->
    <mxCell id="ssthresh2" style="edgeStyle=none;html=1;strokeColor=#fcd34d;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="420" as="sourcePoint" /><mxPoint x="900" y="420" as="targetPoint" /></mxGeometry></mxCell>

    <!-- 4. 慢启动 2 -->
    <mxCell id="line_ss2" style="edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=3;endArrow=none;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="650" y="585" as="sourcePoint" />
        <mxPoint x="800" y="420" as="targetPoint" />
        <Array as="points"><mxPoint x="680" y="570" /><mxPoint x="730" y="540" /><mxPoint x="770" y="480" /></Array>
      </mxGeometry>
    </mxCell>

    <!-- 5. 拥塞避免 2 -->
    <mxCell id="line_ca2" style="edgeStyle=none;html=1;strokeColor=#34d399;strokeWidth=3;endArrow=none;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="800" y="420" as="sourcePoint" /><mxPoint x="900" y="380" as="targetPoint" /></mxGeometry>
    </mxCell>

    <!-- 6. 收到 3 次重复 ACK (分岔点) -->
    
    <!-- 分岔路线 A: TCP Reno (快速恢复) -->
    <mxCell id="line_reno_drop" style="edgeStyle=none;html=1;strokeColor=#34d399;strokeWidth=2;dashed=1;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="895" y="380" as="sourcePoint" /><mxPoint x="895" y="495" as="targetPoint" /></mxGeometry>
    </mxCell>
    <mxCell id="line_reno_ca" style="edgeStyle=none;html=1;strokeColor=#34d399;strokeWidth=3;endArrow=none;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="895" y="495" as="sourcePoint" /><mxPoint x="1100" y="430" as="targetPoint" /></mxGeometry>
    </mxCell>
    
    <!-- 分岔路线 B: TCP Tahoe (重置为1) -->
    <mxCell id="line_tahoe_drop" style="edgeStyle=none;html=1;strokeColor=#a855f7;strokeWidth=2;dashed=1;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="905" y="380" as="sourcePoint" /><mxPoint x="905" y="585" as="targetPoint" /></mxGeometry>
    </mxCell>
    <mxCell id="line_tahoe_ss" style="edgeStyle=none;html=1;strokeColor=#a855f7;strokeWidth=3;dashed=1;endArrow=none;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="905" y="585" as="sourcePoint" />
        <mxPoint x="1100" y="495" as="targetPoint" />
        <Array as="points"><mxPoint x="950" y="570" /><mxPoint x="1020" y="540" /></Array>
      </mxGeometry>
    </mxCell>

    <!-- 状态说明文本 -->
    <mxCell id="label_dup_ack" value="收到 3次重复 ACK" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#ef4444;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="930" y="350" width="150" height="20" as="geometry" />
    </mxCell>
    
    <mxCell id="label_reno" value="Reno (现代主流)&#xa;cwnd 减半至 ssthresh&#xa;进入快速恢复" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#6ee7b7;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="920" y="380" width="150" height="50" as="geometry" />
    </mxCell>
    
    <mxCell id="label_tahoe" value="Tahoe (已废弃)&#xa;cwnd 重置为 1&#xa;重新慢启动" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#c4b5fd;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="930" y="540" width="150" height="50" as="geometry" />
    </mxCell>

    <!-- ssthresh3 = 7 -->
    <mxCell id="ssthresh3" style="edgeStyle=none;html=1;strokeColor=#fcd34d;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="495" as="sourcePoint" /><mxPoint x="1120" y="495" as="targetPoint" /></mxGeometry></mxCell>

  </root>
</mxGraphModel>