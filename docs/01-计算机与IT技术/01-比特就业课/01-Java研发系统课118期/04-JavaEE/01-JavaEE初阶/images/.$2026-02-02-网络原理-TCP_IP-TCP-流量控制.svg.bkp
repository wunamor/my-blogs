<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="850" background="#121212" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- ==================== 标题 ==================== -->
    <mxCell id="title" value="TCP 流量控制 (Flow Control) 与 零窗口探测" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#e5e7eb;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="200" y="30" width="550" height="40" as="geometry" />
    </mxCell>

    <!-- ==================== 节点头部 ==================== -->
    <mxCell id="host_a" value="主机 A (发送方)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#d1d5db;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="170" y="80" width="120" height="30" as="geometry" />
    </mxCell>

    <mxCell id="host_b" value="主机 B (接收方)&#xa;(假设初始接收窗口 rwnd = 3000)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#d1d5db;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="610" y="70" width="220" height="40" as="geometry" />
    </mxCell>

    <!-- ==================== 时间轴 (已修复箭头与标签) ==================== -->
    <mxCell id="timeline_a" style="endArrow=classic;html=1;strokeColor=#4b5563;strokeWidth=1.5;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="230" y="130" as="sourcePoint" />
        <mxPoint x="230" y="800" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    
    <mxCell id="timeline_b" style="endArrow=classic;html=1;strokeColor=#4b5563;strokeWidth=1.5;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="720" y="130" as="sourcePoint" />
        <mxPoint x="720" y="800" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <mxCell id="label_time_a" value="Time ↓" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#9ca3af;" vertex="1" parent="1">
      <mxGeometry x="240" y="780" width="50" height="20" as="geometry" />
    </mxCell>
    
    <mxCell id="label_time_b" value="Time ↓" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#9ca3af;" vertex="1" parent="1">
      <mxGeometry x="730" y="780" width="50" height="20" as="geometry" />
    </mxCell>

    <!-- ==================== 阶段一：正常受控发送 ==================== -->

    <!-- D1: 发送 Seq 1-1000 -->
    <mxCell id="d1_text" value="发送 [Seq = 1 ~ 1000]&#xa;(消耗窗口 1000 字节)" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#93c5fd;" vertex="1" parent="1">
      <mxGeometry x="40" y="145" width="180" height="30" as="geometry" />
    </mxCell>
    <mxCell id="d1_line" style="edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="230" y="160" as="sourcePoint" />
        <mxPoint x="720" y="220" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- A1: ACK 返回剩余窗口 -->
    <mxCell id="a1_text" value="[ACK = 1001, rwnd = 2000]&#xa;(告知发送方：剩余窗口还有 2000)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#6ee7b7;" vertex="1" parent="1">
      <mxGeometry x="730" y="215" width="220" height="30" as="geometry" />
    </mxCell>
    <mxCell id="a1_line" style="edgeStyle=none;html=1;strokeColor=#34d399;strokeWidth=1.5;dashed=1;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="720" y="230" as="sourcePoint" />
        <mxPoint x="230" y="290" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- D2 & D3: 连续发送占满窗口 -->
    <mxCell id="d2_text" value="发送 [Seq = 1001 ~ 2000]" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#93c5fd;" vertex="1" parent="1">
      <mxGeometry x="40" y="280" width="180" height="20" as="geometry" />
    </mxCell>
    <mxCell id="d2_line" style="edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="230" y="290" as="sourcePoint" />
        <mxPoint x="720" y="350" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <mxCell id="d3_text" value="发送 [Seq = 2001 ~ 3000]" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#93c5fd;" vertex="1" parent="1">
      <mxGeometry x="40" y="330" width="180" height="20" as="geometry" />
    </mxCell>
    <mxCell id="d3_line" style="edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="230" y="340" as="sourcePoint" />
        <mxPoint x="720" y="400" as="targetPoint" />
      </mxGeometry>
    </mxCell>


    <!-- ==================== 阶段二：零窗口 (Zero Window) ==================== -->

    <!-- A2: 零窗口通知 -->
    <mxCell id="a2_text" value="[ACK = 3001, rwnd = 0]&#xa;接收缓存已满，通知零窗口！" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#fcd34d;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="730" y="395" width="210" height="30" as="geometry" />
    </mxCell>
    <mxCell id="a2_line" style="edgeStyle=none;html=1;strokeColor=#f59e0b;strokeWidth=2;dashed=1;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="720" y="410" as="sourcePoint" />
        <mxPoint x="230" y="470" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- A 端处理零窗口 -->
    <mxCell id="a_wait_text" value="收到 rwnd=0，停止发送数据。&#xa;启动「持续计时器」&#xa;(Zero Window Probe Timer)" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#9ca3af;" vertex="1" parent="1">
      <mxGeometry x="30" y="465" width="190" height="50" as="geometry" />
    </mxCell>


    <!-- ==================== 阶段三：零窗口探测与窗口更新 ==================== -->

    <!-- D4: 零窗口探测 -->
    <mxCell id="d4_text" value="发送 [零窗口探测报文]&#xa;(仅包含 1 字节数据)" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#c4b5fd;" vertex="1" parent="1">
      <mxGeometry x="40" y="535" width="180" height="30" as="geometry" />
    </mxCell>
    <mxCell id="d4_line" style="edgeStyle=none;html=1;strokeColor=#a78bfa;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="230" y="550" as="sourcePoint" />
        <mxPoint x="720" y="610" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- A3: 窗口更新 -->
    <mxCell id="a3_text" value="[ACK = 3001, rwnd = 2000]&#xa;应用层读取了数据，窗口更新！" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#6ee7b7;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="730" y="605" width="210" height="30" as="geometry" />
    </mxCell>
    <mxCell id="a3_line" style="edgeStyle=none;html=1;strokeColor=#34d399;strokeWidth=2;dashed=1;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="720" y="620" as="sourcePoint" />
        <mxPoint x="230" y="680" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- D5: 恢复发送 -->
    <mxCell id="d5_text" value="重新获得窗口配额&#xa;恢复发送 [Seq = 3001 ~ 4000]" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#93c5fd;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="10" y="675" width="210" height="30" as="geometry" />
    </mxCell>
    <mxCell id="d5_line" style="edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=2;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="230" y="690" as="sourcePoint" />
        <mxPoint x="720" y="750" as="targetPoint" />
      </mxGeometry>
    </mxCell>

  </root>
</mxGraphModel>