<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="600" background="#121212" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- ==================== 标题 ==================== -->
    <mxCell id="title" value="TCP 丢包处理：ACK 丢失 (累计确认 Cumulative ACK)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontColor=#e5e7eb;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="200" y="30" width="550" height="40" as="geometry" />
    </mxCell>

    <!-- ==================== 节点头部 ==================== -->
    <mxCell id="host_a" value="主机 A (发送方)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#d1d5db;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="170" y="80" width="120" height="30" as="geometry" />
    </mxCell>

    <mxCell id="host_b" value="主机 B (接收方)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#d1d5db;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="660" y="80" width="120" height="30" as="geometry" />
    </mxCell>

    <!-- ==================== 时间轴 ==================== -->
    <mxCell id="timeline_a" style="endArrow=none;html=1;strokeColor=#4b5563;strokeWidth=1.5;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="230" y="120" as="sourcePoint" />
        <mxPoint x="230" y="550" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    
    <mxCell id="timeline_b" style="endArrow=none;html=1;strokeColor=#4b5563;strokeWidth=1.5;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="720" y="120" as="sourcePoint" />
        <mxPoint x="720" y="550" as="targetPoint" />
      </mxGeometry>
    </mxCell>


    <!-- ==================== 动态数据交互流程 ==================== -->

    <!-- D1: 发送 Seq 1-1000 -->
    <mxCell id="d1_text" value="发送 [Seq = 1 ~ 1000]" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#93c5fd;" vertex="1" parent="1">
      <mxGeometry x="40" y="150" width="180" height="20" as="geometry" />
    </mxCell>
    <mxCell id="d1_line" style="edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="230" y="160" as="sourcePoint" />
        <mxPoint x="720" y="220" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- A1: ACK 1001 (丢失) -->
    <mxCell id="a1_text" value="下一个是 [ACK=1001]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#6ee7b7;" vertex="1" parent="1">
      <mxGeometry x="730" y="220" width="200" height="20" as="geometry" />
    </mxCell>
    <mxCell id="a1_line" style="edgeStyle=none;html=1;strokeColor=#34d399;strokeWidth=1.5;dashed=1;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="720" y="230" as="sourcePoint" />
        <mxPoint x="480" y="259" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="lost_icon1" value="✖" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#ef4444;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="460" y="249" width="20" height="20" as="geometry" />
    </mxCell>


    <!-- D2: 发送 Seq 1001-2000 -->
    <mxCell id="d2_text" value="发送 [Seq = 1001 ~ 2000]" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#93c5fd;" vertex="1" parent="1">
      <mxGeometry x="40" y="210" width="180" height="20" as="geometry" />
    </mxCell>
    <mxCell id="d2_line" style="edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="230" y="220" as="sourcePoint" />
        <mxPoint x="720" y="280" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- A2: ACK 2001 (丢失) -->
    <mxCell id="a2_text" value="下一个是 [ACK=2001]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#6ee7b7;" vertex="1" parent="1">
      <mxGeometry x="730" y="280" width="200" height="20" as="geometry" />
    </mxCell>
    <mxCell id="a2_line" style="edgeStyle=none;html=1;strokeColor=#34d399;strokeWidth=1.5;dashed=1;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="720" y="290" as="sourcePoint" />
        <mxPoint x="480" y="319" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="lost_icon2" value="✖" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#ef4444;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="460" y="309" width="20" height="20" as="geometry" />
    </mxCell>


    <!-- D3: 发送 Seq 2001-3000 -->
    <mxCell id="d3_text" value="发送 [Seq = 2001 ~ 3000]" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#93c5fd;" vertex="1" parent="1">
      <mxGeometry x="40" y="270" width="180" height="20" as="geometry" />
    </mxCell>
    <mxCell id="d3_line" style="edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="230" y="280" as="sourcePoint" />
        <mxPoint x="720" y="340" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- A3: ACK 3001 (成功送达) -->
    <mxCell id="a3_text" value="下一个是 [ACK=3001]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#fcd34d;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="730" y="340" width="200" height="20" as="geometry" />
    </mxCell>
    <mxCell id="a3_line" style="edgeStyle=none;html=1;strokeColor=#f59e0b;strokeWidth=2;dashed=1;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="720" y="350" as="sourcePoint" />
        <mxPoint x="230" y="410" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- 说明文本 -->
    <mxCell id="cum_note" value="主机 A 收到 ACK 3001，即代表 3001 之前的所有数据均已成功送达。&#xa;无需理会前面丢失的 ACK，继续往后发送数据。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#9ca3af;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="250" y="430" width="450" height="40" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>