      <mxGeometry relative="1" as="geometry">
        <mxPoint x="230" y="240" as="sourcePoint" />
        <mxPoint x="720" y="300" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- A2: ACK 1 (冗余 1) -->
    <mxCell id="a2_text" value="冗余① [ACK=1]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#6ee7b7;" vertex="1" parent="1">
      <mxGeometry x="730" y="300" width="200" height="20" as="geometry" />
    </mxCell>
    <mxCell id="a2_line" style="edgeStyle=none;html=1;strokeColor=#34d399;strokeWidth=1.5;dashed=1;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="720" y="310" as="sourcePoint" />
        <mxPoint x="230" y="370" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- D4: 发送 Seq 3001-4000 -->
    <mxCell id="d4_text" value="发送 [Seq = 3001 ~ 4000]" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#93c5fd;" vertex="1" parent="1">
      <mxGeometry x="40" y="270" width="180" height="20" as="geometry" />
