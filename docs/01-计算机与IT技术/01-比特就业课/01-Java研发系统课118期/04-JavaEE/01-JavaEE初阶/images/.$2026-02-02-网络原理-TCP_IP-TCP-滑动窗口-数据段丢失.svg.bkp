    <mxCell id="d4_line" style="edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="230" y="280" as="sourcePoint" />
        <mxPoint x="720" y="340" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- A3: ACK 1 (冗余 2) -->
    <mxCell id="a3_text" value="冗余② [ACK=1]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#6ee7b7;" vertex="1" parent="1">
      <mxGeometry x="730" y="340" width="200" height="20" as="geometry" />
    </mxCell>
    <mxCell id="a3_line" style="edgeStyle=none;html=1;strokeColor=#34d399;strokeWidth=1.5;dashed=1;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="720" y="350" as="sourcePoint" />
        <mxPoint x="230" y="410" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- D5: 发送 Seq 4001-5000 -->
    <mxCell id="d5_text" value="发送 [Seq = 4001 ~ 5000]" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#93c5fd;" vertex="1" parent="1">
      <mxGeometry x="40" y="310" width="180" height="20" as="geometry" />
    </mxCell>
    <mxCell id="d5_line" style="edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="230" y="320" as="sourcePoint" />
        <mxPoint x="720" y="380" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- A4: ACK 1 (冗余 3) -->
    <mxCell id="a4_text" value="冗余③ [ACK=1]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#6ee7b7;" vertex="1" parent="1">
      <mxGeometry x="730" y="380" width="200" height="20" as="geometry" />
    </mxCell>
    <mxCell id="a4_line" style="edgeStyle=none;html=1;strokeColor=#34d399;strokeWidth=1.5;dashed=1;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="720" y="390" as="sourcePoint" />
        <mxPoint x="230" y="450" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- 触发重传 -->
    <mxCell id="ret_text" value="收到 3 次相同重复应答&#xa;快速重传 [Seq = 1 ~ 1000]" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#fcd34d;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="10" y="460" width="210" height="40" as="geometry" />
