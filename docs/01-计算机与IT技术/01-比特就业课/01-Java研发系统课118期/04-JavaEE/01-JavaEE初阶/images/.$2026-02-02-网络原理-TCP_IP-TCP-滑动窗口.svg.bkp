<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" background="#121212" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- ==================== 标题 ==================== -->
    <mxCell id="title" value="TCP 滑动窗口机制 (Sliding Window)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#e5e7eb;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="250" y="30" width="500" height="50" as="geometry" />
    </mxCell>

    <!-- ==================== 图例 (Legend) ==================== -->
    <mxCell id="legend_1_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;" vertex="1" parent="1">
      <mxGeometry x="150" y="100" width="20" height="20" as="geometry" />
    </mxCell>
    <mxCell id="legend_1_text" value="已发送并收到确认 (ACK)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#9ca3af;fontSize=13;" vertex="1" parent="1">
