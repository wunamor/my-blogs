    <!-- Block 12-15: 不允许发送 -->
    <mxCell id="s1_b12" value="12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#374151;fontColor=#4b5563;fontSize=14;" vertex="1" parent="1"><mxGeometry x="535" y="220" width="35" height="45" as="geometry" /></mxCell>
