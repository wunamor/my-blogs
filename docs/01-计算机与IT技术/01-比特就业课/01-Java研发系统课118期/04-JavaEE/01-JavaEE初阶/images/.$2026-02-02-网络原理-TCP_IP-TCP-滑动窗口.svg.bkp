    <mxCell id="s1_b14" value="14" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#374151;fontColor=#4b5563;fontSize=14;" vertex="1" parent="1"><mxGeometry x="605" y="220" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s1_b15" value="15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#374151;fontColor=#4b5563;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="220" width="35" height="45" as="geometry" /></mxCell>

    <!-- 窗口虚线框 (覆盖 4 到 11，宽度 = 8个块 = 280) -->
    <mxCell id="s1_window" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#fcd34d;strokeWidth=2;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="255" y="210" width="280" height="65" as="geometry" />
    </mxCell>

    <!-- 窗口文字标识 -->
    <mxCell id="s1_win_text" value="可用窗口大小 (Window Size = 8)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#fcd34d;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="295" y="180" width="200" height="20" as="geometry" />
    </mxCell>

    <!-- 指针 SND.UNA -->
    <mxCell id="s1_ptr_una" style="edgeStyle=none;html=1;strokeColor=#9ca3af;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="255" y="320" as="sourcePoint" />
        <mxPoint x="255" y="280" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="s1_lbl_una" value="SND.UNA&#xa;(发出去未确认的&#xa;第一个字节)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#9ca3af;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="205" y="325" width="100" height="50" as="geometry" />
    </mxCell>

    <!-- 指针 SND.NXT -->
    <mxCell id="s1_ptr_nxt" style="edgeStyle=none;html=1;strokeColor=#9ca3af;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="360" y="320" as="sourcePoint" />
        <mxPoint x="360" y="280" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="s1_lbl_nxt" value="SND.NXT&#xa;(下一个要发送的&#xa;第一个字节)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#9ca3af;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="310" y="325" width="100" height="50" as="geometry" />
    </mxCell>


    <!-- ==================== 动作：收到 ACK 使得窗口滑动 ==================== -->
    <mxCell id="action_arrow" style="edgeStyle=none;html=1;strokeColor=#6b7280;strokeWidth=2;endArrow=classic;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="430" y="400" as="sourcePoint" />
        <mxPoint x="430" y="450" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="action_text" value="收到字节 4, 5, 6 的 ACK，窗口整体向右滑动" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#d1d5db;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="450" y="410" width="300" height="30" as="geometry" />
    </mxCell>


    <!-- ==================== 状态二：窗口滑动后 ==================== -->
    <mxCell id="state2_title" value="状态二：滑动后" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#e5e7eb;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="150" y="460" width="200" height="30" as="geometry" />
    </mxCell>

    <!-- Block 1-6: 变为已确认 (原4,5,6加入此阵营) -->
    <mxCell id="s2_b1" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontColor=#64748b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="520" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s2_b2" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontColor=#64748b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="185" y="520" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s2_b3" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontColor=#64748b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="220" y="520" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s2_b4" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontColor=#64748b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="255" y="520" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s2_b5" value="5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontColor=#64748b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="520" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s2_b6" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontColor=#64748b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="325" y="520" width="35" height="45" as="geometry" /></mxCell>

    <!-- Block 7-8: 假设这段时间发送了 7, 8，变为已发送未确认 -->
    <mxCell id="s2_b7" value="7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#60a5fa;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="520" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s2_b8" value="8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#60a5fa;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="395" y="520" width="35" height="45" as="geometry" /></mxCell>

    <!-- Block 9-14: 允许发送未发送 (窗口腾出了新空间) -->
    <mxCell id="s2_b9" value="9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#34d399;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="520" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s2_b10" value="10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#34d399;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="465" y="520" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s2_b11" value="11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#34d399;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="520" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s2_b12" value="12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#34d399;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="535" y="520" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s2_b13" value="13" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#34d399;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="520" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s2_b14" value="14" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#34d399;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="605" y="520" width="35" height="45" as="geometry" /></mxCell>

    <!-- Block 15: 不允许发送 -->
    <mxCell id="s2_b15" value="15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#374151;fontColor=#4b5563;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="520" width="35" height="45" as="geometry" /></mxCell>

    <!-- 窗口虚线框 (跟随指针右移，覆盖 7 到 14) -->
    <mxCell id="s2_window" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#fcd34d;strokeWidth=2;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="360" y="510" width="280" height="65" as="geometry" />
    </mxCell>

    <!-- 新的 SND.UNA 指针 (移到了 7) -->
    <mxCell id="s2_ptr_una" style="edgeStyle=none;html=1;strokeColor=#9ca3af;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="360" y="620" as="sourcePoint" />
        <mxPoint x="360" y="580" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="s2_lbl_una" value="SND.UNA&#xa;(移至 7)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#9ca3af;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="310" y="625" width="100" height="30" as="geometry" />
    </mxCell>

    <!-- 新的 SND.NXT 指针 (假设发了7和8，移到了 9) -->
    <mxCell id="s2_ptr_nxt" style="edgeStyle=none;html=1;strokeColor=#9ca3af;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="430" y="620" as="sourcePoint" />
        <mxPoint x="430" y="580" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="s2_lbl_nxt" value="SND.NXT&#xa;(移至 9)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#9ca3af;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="380" y="625" width="100" height="30" as="geometry" />
    </mxCell>

    <!-- 窗口右边界标识 (说明腾出了新空间) -->
    <mxCell id="s2_ptr_end" style="edgeStyle=none;html=1;strokeColor=#fcd34d;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
