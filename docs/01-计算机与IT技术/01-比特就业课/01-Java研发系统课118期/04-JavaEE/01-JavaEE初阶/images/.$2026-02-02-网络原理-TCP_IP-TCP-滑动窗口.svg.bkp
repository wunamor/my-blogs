      <mxGeometry x="360" y="100" width="20" height="20" as="geometry" />
    </mxCell>
    <mxCell id="legend_2_text" value="已发送但未收到确认" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#93c5fd;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="390" y="95" width="140" height="30" as="geometry" />
    </mxCell>

    <mxCell id="legend_3_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#34d399;" vertex="1" parent="1">
      <mxGeometry x="550" y="100" width="20" height="20" as="geometry" />
    </mxCell>
    <mxCell id="legend_3_text" value="允许发送但尚未发送" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#6ee7b7;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="580" y="95" width="140" height="30" as="geometry" />
    </mxCell>

    <mxCell id="legend_4_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#374151;" vertex="1" parent="1">
      <mxGeometry x="740" y="100" width="20" height="20" as="geometry" />
    </mxCell>
    <mxCell id="legend_4_text" value="不允许发送 (超出窗口)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#6b7280;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="770" y="95" width="150" height="30" as="geometry" />
    </mxCell>


    <!-- ==================== 状态一：初始滑动窗口 ==================== -->
    <mxCell id="state1_title" value="状态一：初始时刻" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#e5e7eb;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="150" y="160" width="200" height="30" as="geometry" />
    </mxCell>

    <!-- Block 1-3: 已确认 -->
    <mxCell id="s1_b1" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontColor=#64748b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="220" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s1_b2" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontColor=#64748b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="185" y="220" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s1_b3" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontColor=#64748b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="220" y="220" width="35" height="45" as="geometry" /></mxCell>

    <!-- Block 4-6: 已发送未确认 -->
    <mxCell id="s1_b4" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#60a5fa;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="255" y="220" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s1_b5" value="5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#60a5fa;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="220" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s1_b6" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#60a5fa;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="325" y="220" width="35" height="45" as="geometry" /></mxCell>

    <!-- Block 7-11: 允许发送未发送 -->
    <mxCell id="s1_b7" value="7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#34d399;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="220" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s1_b8" value="8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#34d399;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="395" y="220" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s1_b9" value="9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#34d399;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="220" width="35" height="45" as="geometry" /></mxCell>
    <mxCell id="s1_b10" value="10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#34d399;fontColor=#d1d5db;fontSize=14;" vertex="1" parent="1"><mxGeometry x="465" y="220" width="35" height="45" as="geometry" /></mxCell>
