<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="700" background="#121212" math="0" shadow="1">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- ==================== 标题 ==================== -->
    <mxCell id="title" value="TCP 超时重传机制 (Timeout Retransmission)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="200" y="30" width="500" height="50" as="geometry" />
    </mxCell>

    <!-- ==================== 节点头部 (实体框) ==================== -->
    <mxCell id="host_a" value="主机 A&#xa;(发送方)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#3b82f6;strokeWidth=2;fontColor=#ffffff;fontSize=16;fontStyle=1;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="140" y="100" width="120" height="50" as="geometry" />
    </mxCell>

    <mxCell id="host_b" value="主机 B&#xa;(接收方)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#ffffff;fontSize=16;fontStyle=1;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="640" y="100" width="120" height="50" as="geometry" />
    </mxCell>

    <!-- ==================== 时间轴 (垂直虚线生命线) ==================== -->
    <mxCell id="timeline_a" style="endArrow=classic;html=1;strokeColor=#4b5563;strokeWidth=2;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="200" y="150" as="sourcePoint" />
        <mxPoint x="200" y="600" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <mxCell id="timeline_b" style="endArrow=classic;html=1;strokeColor=#4b5563;strokeWidth=2;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="700" y="150" as="sourcePoint" />
        <mxPoint x="700" y="600" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- 时间轴底部标识 -->
    <mxCell id="label_time1" value="时间 (Time) ↓" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#9ca3af;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="210" y="570" width="80" height="20" as="geometry" />
    </mxCell>
    <mxCell id="label_time2" value="时间 (Time) ↓" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#9ca3af;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="710" y="570" width="80" height="20" as="geometry" />
    </mxCell>


    <!-- ==================== 第一阶段：正常发送但遭遇丢包 ==================== -->
    
    <!-- 发送数据 (中途停止) -->
    <mxCell id="arrow_lost" value="发送数据报文 [Seq = 1]" style="edgeStyle=none;html=1;strokeColor=#3b82f6;strokeWidth=2;fontColor=#93c5fd;fontSize=15;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="200" y="200" as="sourcePoint" />
        <mxPoint x="450" y="230" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- 丢包红叉与文字提示 -->
    <mxCell id="lost_x_icon" value="✖" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#ef4444;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="440" y="215" width="20" height="30" as="geometry" />
    </mxCell>
    <mxCell id="lost_text" value="报文在网络中丢失&#xa;(或者 B 返回的 ACK 丢失)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#ef4444;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="465" y="215" width="200" height="40" as="geometry" />
    </mxCell>

    <!-- ==================== 计时器与等待阶段 ==================== -->
    
    <!-- 左侧大括号表示计时器 (已修正 direction=east，确保为 } 形状) -->
    <mxCell id="timer_bracket" value="超时计时器&#xa;(RTO) 触发&#xa;未收到 ACK" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;direction=east;size=0.5;fontColor=#f87171;strokeColor=#ef4444;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="170" y="200" width="20" height="180" as="geometry" />
    </mxCell>


    <!-- ==================== 第二阶段：超时重传与正常确认 ==================== -->
    
    <!-- 触发重传数据 -->
    <mxCell id="arrow_retransmit" value="超时重传数据 [Seq = 1]" style="edgeStyle=none;html=1;strokeColor=#f59e0b;strokeWidth=3;fontColor=#fcd34d;fontSize=15;fontStyle=1;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="200" y="380" as="sourcePoint" />
        <mxPoint x="700" y="440" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- 主机B正常返回ACK -->
    <mxCell id="arrow_ack" value="[ACK] 确认应答" style="edgeStyle=none;html=1;strokeColor=#10b981;strokeWidth=2;fontColor=#34d399;fontSize=15;align=center;verticalAlign=bottom;spacingBottom=5;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="700" y="470" as="sourcePoint" />
        <mxPoint x="200" y="530" as="targetPoint" />
      </mxGeometry>
    </mxCell>


    <!-- ==================== 说明看板 (已精简标题) ==================== -->
    <mxCell id="note_architect" value="【解析】：&#xa;1. 计时器机制：主机 A 发送数据后，会立刻启动一个「超时重传计时器（RTO）」。&#xa;2. 触发重传：如果在这个计时器规定的时间内，A 一直没有收到主机 B 发来的对应 ACK（不管是原数据丢了，还是 ACK 在回来的路上丢了），A 都会无条件触发重传逻辑。&#xa;3. 去重机制：如果是因为 ACK 丢失导致的重传，主机 B 实际上会收到两份相同的 [Seq=1] 数据。此时，B 的 TCP 协议栈会根据 Seq 号自动丢弃重复数据，并再次补发一个 ACK。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#262626;strokeColor=#404040;fontColor=#e5e7eb;fontSize=14;align=left;spacingLeft=15;spacingTop=10;spacingRight=15;" vertex="1" parent="1">
      <mxGeometry x="80" y="610" width="760" height="110" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>