<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="600" background="#121212" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- ==================== 标题 ==================== -->
    <mxCell id="title" value="TCP 连接管理 (三次握手 Three-way Handshake)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#e5e7eb;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="150" y="30" width="600" height="50" as="geometry" />
    </mxCell>

    <!-- ==================== 节点头部 ==================== -->
    <mxCell id="client" value="客户端 (Client)&#xa;主动打开" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#60a5fa;strokeWidth=1.5;fontColor=#d1d5db;fontSize=15;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="140" y="100" width="120" height="50" as="geometry" />
    </mxCell>

    <mxCell id="server" value="服务器 (Server)&#xa;被动打开" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#34d399;strokeWidth=1.5;fontColor=#d1d5db;fontSize=15;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="640" y="100" width="120" height="50" as="geometry" />
    </mxCell>

    <!-- ==================== 时间轴 (垂直虚线) ==================== -->
    <mxCell id="timeline_c" style="endArrow=classic;html=1;strokeColor=#4b5563;strokeWidth=1.5;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="200" y="150" as="sourcePoint" />
        <mxPoint x="200" y="550" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <mxCell id="timeline_s" style="endArrow=classic;html=1;strokeColor=#4b5563;strokeWidth=1.5;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="700" y="150" as="sourcePoint" />
        <mxPoint x="700" y="550" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <mxCell id="label_time_c" value="Time ↓" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#9ca3af;" vertex="1" parent="1">
      <mxGeometry x="210" y="530" width="50" height="20" as="geometry" />
    </mxCell>
    
    <mxCell id="label_time_s" value="Time ↓" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#9ca3af;" vertex="1" parent="1">
      <mxGeometry x="710" y="530" width="50" height="20" as="geometry" />
    </mxCell>


    <!-- ==================== 初始状态 (纯文本无边框) ==================== -->
    <mxCell id="state_c_closed" value="CLOSED" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#9ca3af;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="80" y="150" width="100" height="30" as="geometry" />
    </mxCell>

    <mxCell id="state_s_listen" value="LISTEN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#6ee7b7;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="720" y="150" width="100" height="30" as="geometry" />
    </mxCell>


    <!-- ==================== 第一次握手 (SYN) ==================== -->
    <mxCell id="arrow_syn" value="第一次握手 (SYN 报文)&#xa;SYN = 1, seq = x" style="edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=2;fontColor=#d1d5db;fontSize=14;align=center;verticalAlign=bottom;spacingBottom=8;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="200" y="210" as="sourcePoint" />
        <mxPoint x="700" y="270" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <mxCell id="state_c_syn_sent" value="SYN_SENT" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#93c5fd;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="80" y="210" width="100" height="30" as="geometry" />
    </mxCell>

    <mxCell id="state_s_syn_rcvd" value="SYN_RCVD" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#6ee7b7;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="720" y="270" width="100" height="30" as="geometry" />
    </mxCell>


    <!-- ==================== 第二次握手 (SYN + ACK) ==================== -->
    <mxCell id="arrow_syn_ack" value="第二次握手 (SYN+ACK 报文)&#xa;SYN = 1, ACK = 1, seq = y, ack = x + 1" style="edgeStyle=none;html=1;strokeColor=#34d399;strokeWidth=2;fontColor=#d1d5db;fontSize=14;align=center;verticalAlign=bottom;spacingBottom=8;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="700" y="320" as="sourcePoint" />
        <mxPoint x="200" y="380" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <mxCell id="state_c_established" value="ESTABLISHED" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#93c5fd;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="80" y="380" width="100" height="30" as="geometry" />
    </mxCell>


    <!-- ==================== 第三次握手 (ACK) ==================== -->
    <mxCell id="arrow_ack" value="第三次握手 (ACK 报文)&#xa;ACK = 1, seq = x + 1, ack = y + 1" style="edgeStyle=none;html=1;strokeColor=#d97706;strokeWidth=2;fontColor=#d1d5db;fontSize=14;align=center;verticalAlign=bottom;spacingBottom=8;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="200" y="420" as="sourcePoint" />
        <mxPoint x="700" y="480" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <mxCell id="state_s_established" value="ESTABLISHED" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#6ee7b7;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="720" y="480" width="100" height="30" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>