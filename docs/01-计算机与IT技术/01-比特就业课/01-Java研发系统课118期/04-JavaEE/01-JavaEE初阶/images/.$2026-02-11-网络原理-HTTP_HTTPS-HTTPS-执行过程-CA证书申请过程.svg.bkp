<!DOCTYPE svg PUBLIC "-//W3C//DTD SVG 1.1//EN" "http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd">
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" width="881px" height="779px" viewBox="-0.5 -0.5 881 779" content="&lt;mxfile host=&quot;Electron&quot; agent=&quot;Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/24.7.8 Chrome/128.0.6613.36 Electron/32.0.1 Safari/537.36&quot; version=&quot;24.7.8&quot;&gt;&#10;  &lt;diagram id=&quot;VoOxtT2WnXROTpNbEF2W&quot; name=&quot;第 1 页&quot;&gt;&#10;    &lt;mxGraphModel dx=&quot;1036&quot; dy=&quot;606&quot; grid=&quot;1&quot; gridSize=&quot;10&quot; guides=&quot;1&quot; tooltips=&quot;1&quot; connect=&quot;1&quot; arrows=&quot;1&quot; fold=&quot;1&quot; page=&quot;1&quot; pageScale=&quot;1&quot; pageWidth=&quot;900&quot; pageHeight=&quot;700&quot; background=&quot;#121212&quot; math=&quot;0&quot; shadow=&quot;1&quot;&gt;&#10;      &lt;root&gt;&#10;        &lt;mxCell id=&quot;0&quot; /&gt;&#10;        &lt;mxCell id=&quot;1&quot; parent=&quot;0&quot; /&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-91&quot; value=&quot;HTTPS 核心加密过程 (含被入侵路由器的被动嗅探视角)&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#e5e7eb;fontStyle=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;230&quot; y=&quot;30&quot; width=&quot;600&quot; height=&quot;40&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-92&quot; value=&quot;客户端 (浏览器)&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#3b82f6;fontColor=#d1d5db;fontSize=16;fontStyle=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;150&quot; y=&quot;80&quot; width=&quot;160&quot; height=&quot;40&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-93&quot; value=&quot;被入侵的中间路由器&amp;#xa;(仅嗅探窃听，无中间人篡改)&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#ef4444;fontColor=#fca5a5;fontSize=14;fontStyle=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;430&quot; y=&quot;80&quot; width=&quot;200&quot; height=&quot;40&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-94&quot; value=&quot;目标 Web 服务器&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;fontColor=#d1d5db;fontSize=16;fontStyle=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;750&quot; y=&quot;80&quot; width=&quot;160&quot; height=&quot;40&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-95&quot; style=&quot;endArrow=classic;html=1;strokeColor=#4b5563;strokeWidth=1.5;dashed=1;&quot; parent=&quot;1&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;230&quot; y=&quot;120&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;230&quot; y=&quot;800&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-96&quot; style=&quot;endArrow=none;html=1;strokeColor=#ef4444;strokeWidth=1.5;dashed=1;&quot; parent=&quot;1&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;530&quot; y=&quot;120&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;530&quot; y=&quot;780&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-97&quot; style=&quot;endArrow=classic;html=1;strokeColor=#4b5563;strokeWidth=1.5;dashed=1;&quot; parent=&quot;1&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;830&quot; y=&quot;120&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;830&quot; y=&quot;800&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-98&quot; value=&quot;Time ↓&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#9ca3af;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;240&quot; y=&quot;780&quot; width=&quot;50&quot; height=&quot;20&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-99&quot; value=&quot;Time ↓&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#9ca3af;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;840&quot; y=&quot;780&quot; width=&quot;50&quot; height=&quot;20&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-100&quot; value=&quot;⓪ 客户端发送证书请求 (请求服务器提供数字证书证明身份)&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#93c5fd;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;280&quot; y=&quot;140&quot; width=&quot;500&quot; height=&quot;20&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-101&quot; value=&quot;&quot; style=&quot;edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=1.5;endArrow=classic;&quot; parent=&quot;1&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;230&quot; y=&quot;170&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;830&quot; y=&quot;170&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-102&quot; value=&quot;① Client Hello (发送：客户端随机数 Client_Random、支持的加密套件)&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#93c5fd;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;280&quot; y=&quot;210&quot; width=&quot;500&quot; height=&quot;20&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-103&quot; value=&quot;&quot; style=&quot;edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=1.5;endArrow=classic;&quot; parent=&quot;1&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;230&quot; y=&quot;240&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;830&quot; y=&quot;240&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-104&quot; value=&quot;👁️ 路由器截获明文：Client_Random 及支持的算法&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#fcd34d;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;380&quot; y=&quot;250&quot; width=&quot;300&quot; height=&quot;20&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-105&quot; value=&quot;② Server Hello &amp;amp; Certificate (发送：服务端随机数 Server_Random、数字证书[含公钥])&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#34d399;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;250&quot; y=&quot;300&quot; width=&quot;560&quot; height=&quot;20&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-106&quot; value=&quot;&quot; style=&quot;edgeStyle=none;html=1;strokeColor=#10b981;strokeWidth=1.5;endArrow=classic;&quot; parent=&quot;1&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;830&quot; y=&quot;330&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;230&quot; y=&quot;330&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-107&quot; value=&quot;👁️ 路由器截获明文：Server_Random 及 服务器公钥&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#fcd34d;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;380&quot; y=&quot;340&quot; width=&quot;300&quot; height=&quot;20&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-108&quot; value=&quot;③ 客户端校验证书有效后，生成核心机密：&amp;#xa;预主密钥 (Pre-Master Secret)&amp;#xa;并使用刚才收到的【服务器公钥】将其加密&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#3b82f6;fontColor=#93c5fd;fontSize=13;align=center;dashed=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;90&quot; y=&quot;390&quot; width=&quot;280&quot; height=&quot;60&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-109&quot; value=&quot;④ Client Key Exchange (发送：被公钥加密后的 Pre-Master Secret)&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#93c5fd;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;280&quot; y=&quot;480&quot; width=&quot;500&quot; height=&quot;20&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-110&quot; value=&quot;&quot; style=&quot;edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=2;endArrow=classic;&quot; parent=&quot;1&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;230&quot; y=&quot;510&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;830&quot; y=&quot;510&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-111&quot; value=&quot;⛔ 截获密文！路由器没有【服务器私钥】，绝对无法解密此报文！&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#ef4444;fontStyle=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;330&quot; y=&quot;525&quot; width=&quot;400&quot; height=&quot;20&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-112&quot; value=&quot;⑤ 计算最终会话密钥 (Session Key):&amp;#xa;Client_Random + Server_Random + Pre-Master&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#3b82f6;fontColor=#d1d5db;fontSize=12;align=center;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;90&quot; y=&quot;580&quot; width=&quot;280&quot; height=&quot;40&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-113&quot; value=&quot;⑤ 用私钥解密得到 Pre-Master Secret，同理计算会话密钥:&amp;#xa;Client_Random + Server_Random + Pre-Master&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#10b981;fontColor=#d1d5db;fontSize=12;align=center;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;690&quot; y=&quot;580&quot; width=&quot;280&quot; height=&quot;40&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-114&quot; value=&quot;✖ 路由器因无法获取 Pre-Master，无法合成 Session Key&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#ef4444;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;355&quot; y=&quot;590&quot; width=&quot;350&quot; height=&quot;20&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-115&quot; value=&quot;⑥ HTTPS 加密通信阶段 (使用生成的 Session Key 进行对称加密传输)&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#fcd34d;fontStyle=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;280&quot; y=&quot;660&quot; width=&quot;500&quot; height=&quot;20&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-116&quot; value=&quot;[ Application Data ]&quot; style=&quot;edgeStyle=none;html=1;strokeColor=#f59e0b;strokeWidth=2;fontColor=#fcd34d;fontSize=14;fontStyle=1;align=center;verticalAlign=bottom;spacingBottom=5;endArrow=classic;startArrow=classic;&quot; parent=&quot;1&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;230&quot; y=&quot;700&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;830&quot; y=&quot;700&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;5DwtJKmxQQW1hQIWXWCG-117&quot; value=&quot;⛔ 路由器只能看到一堆乱码，无法窃听任何真实的业务数据！&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#ef4444;fontStyle=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;330&quot; y=&quot;720&quot; width=&quot;400&quot; height=&quot;20&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;      &lt;/root&gt;&#10;    &lt;/mxGraphModel&gt;&#10;  &lt;/diagram&gt;&#10;&lt;/mxfile&gt;&#10;" style="background-color: rgb(18, 18, 18);"><defs/><rect fill="#121212" width="100%" height="100%" x="0" y="0"/><g><g data-cell-id="0"><g data-cell-id="1"><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-91"><g><rect x="140" y="0" width="600" height="40" fill="none" stroke="none" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 598px; height: 1px; padding-top: 20px; margin-left: 141px;"><div data-drawio-colors="color: #e5e7eb; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 22px; font-family: Helvetica; color: rgb(229, 231, 235); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: normal; overflow-wrap: normal;">HTTPS 核心加密过程 (含被入侵路由器的被动嗅探视角)</div></div></div></foreignObject><text x="440" y="27" fill="#e5e7eb" font-family="&quot;Helvetica&quot;" font-size="22px" text-anchor="middle" font-weight="bold">HTTPS 核心加密过程 (含被入侵路由器的被动嗅探视角)</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-92"><g><rect x="60" y="50" width="160" height="40" rx="6" ry="6" fill="#1e3a8a" stroke="#3b82f6" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 158px; height: 1px; padding-top: 70px; margin-left: 61px;"><div data-drawio-colors="color: #d1d5db; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 16px; font-family: Helvetica; color: rgb(209, 213, 219); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: normal; overflow-wrap: normal;">客户端 (浏览器)</div></div></div></foreignObject><text x="140" y="75" fill="#d1d5db" font-family="&quot;Helvetica&quot;" font-size="16px" text-anchor="middle" font-weight="bold">客户端 (浏览器)</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-93"><g><rect x="340" y="50" width="200" height="40" rx="6" ry="6" fill="#7f1d1d" stroke="#ef4444" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 198px; height: 1px; padding-top: 70px; margin-left: 341px;"><div data-drawio-colors="color: #fca5a5; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 14px; font-family: Helvetica; color: rgb(252, 165, 165); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: normal; overflow-wrap: normal;">被入侵的中间路由器<br />(仅嗅探窃听，无中间人篡改)</div></div></div></foreignObject><text x="440" y="74" fill="#fca5a5" font-family="&quot;Helvetica&quot;" font-size="14px" text-anchor="middle" font-weight="bold">被入侵的中间路由器&#xa;(仅嗅探窃听，无中间人篡改)</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-94"><g><rect x="660" y="50" width="160" height="40" rx="6" ry="6" fill="#064e3b" stroke="#10b981" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 158px; height: 1px; padding-top: 70px; margin-left: 661px;"><div data-drawio-colors="color: #d1d5db; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 16px; font-family: Helvetica; color: rgb(209, 213, 219); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: normal; overflow-wrap: normal;">目标 Web 服务器</div></div></div></foreignObject><text x="740" y="75" fill="#d1d5db" font-family="&quot;Helvetica&quot;" font-size="16px" text-anchor="middle" font-weight="bold">目标 Web 服务器</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-95"><g><path d="M 140 90 L 140 762.7" fill="none" stroke="#4b5563" stroke-width="1.5" stroke-miterlimit="10" stroke-dasharray="4.5 4.5" pointer-events="stroke"/><path d="M 140 768.32 L 136.25 760.82 L 140 762.7 L 143.75 760.82 Z" fill="#4b5563" stroke="#4b5563" stroke-width="1.5" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-96"><g><path d="M 440 90 L 440 750" fill="none" stroke="#ef4444" stroke-width="1.5" stroke-miterlimit="10" stroke-dasharray="4.5 4.5" pointer-events="stroke"/></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-97"><g><path d="M 740 90 L 740 762.7" fill="none" stroke="#4b5563" stroke-width="1.5" stroke-miterlimit="10" stroke-dasharray="4.5 4.5" pointer-events="stroke"/><path d="M 740 768.32 L 736.25 760.82 L 740 762.7 L 743.75 760.82 Z" fill="#4b5563" stroke="#4b5563" stroke-width="1.5" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-98"><g><rect x="150" y="750" width="50" height="20" fill="none" stroke="none" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 48px; height: 1px; padding-top: 760px; margin-left: 151px;"><div data-drawio-colors="color: #9ca3af; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(156, 163, 175); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">Time ↓</div></div></div></foreignObject><text x="175" y="764" fill="#9ca3af" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">Time ↓</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-99"><g><rect x="750" y="750" width="50" height="20" fill="none" stroke="none" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 48px; height: 1px; padding-top: 760px; margin-left: 751px;"><div data-drawio-colors="color: #9ca3af; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(156, 163, 175); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">Time ↓</div></div></div></foreignObject><text x="775" y="764" fill="#9ca3af" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">Time ↓</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-100"><g><rect x="190" y="110" width="500" height="20" fill="none" stroke="none" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 498px; height: 1px; padding-top: 120px; margin-left: 191px;"><div data-drawio-colors="color: #93c5fd; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 14px; font-family: Helvetica; color: rgb(147, 197, 253); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">⓪ 客户端发送证书请求 (请求服务器提供数字证书证明身份)</div></div></div></foreignObject><text x="440" y="124" fill="#93c5fd" font-family="&quot;Helvetica&quot;" font-size="14px" text-anchor="middle">⓪ 客户端发送证书请求 (请求服务器提供数字证书证明身份)</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-101"><g><path d="M 140 140 L 732.7 140" fill="none" stroke="#60a5fa" stroke-width="1.5" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 738.32 140 L 730.82 143.75 L 732.7 140 L 730.82 136.25 Z" fill="#60a5fa" stroke="#60a5fa" stroke-width="1.5" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-102"><g><rect x="190" y="180" width="500" height="20" fill="none" stroke="none" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 498px; height: 1px; padding-top: 190px; margin-left: 191px;"><div data-drawio-colors="color: #93c5fd; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 14px; font-family: Helvetica; color: rgb(147, 197, 253); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">① Client Hello (发送：客户端随机数 Client_Random、支持的加密套件)</div></div></div></foreignObject><text x="440" y="194" fill="#93c5fd" font-family="&quot;Helvetica&quot;" font-size="14px" text-anchor="middle">① Client Hello (发送：客户端随机数 Client_Random、支持的加密套件)</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-103"><g><path d="M 140 210 L 732.7 210" fill="none" stroke="#60a5fa" stroke-width="1.5" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 738.32 210 L 730.82 213.75 L 732.7 210 L 730.82 206.25 Z" fill="#60a5fa" stroke="#60a5fa" stroke-width="1.5" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-104"><g><rect x="290" y="220" width="300" height="20" fill="none" stroke="none" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 298px; height: 1px; padding-top: 230px; margin-left: 291px;"><div data-drawio-colors="color: #fcd34d; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 13px; font-family: Helvetica; color: rgb(252, 211, 77); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">👁️ 路由器截获明文：Client_Random 及支持的算法</div></div></div></foreignObject><text x="440" y="234" fill="#fcd34d" font-family="&quot;Helvetica&quot;" font-size="13px" text-anchor="middle">👁️ 路由器截获明文：Client_Random 及支持的算法</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-105"><g><rect x="160" y="270" width="560" height="20" fill="none" stroke="none" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 558px; height: 1px; padding-top: 280px; margin-left: 161px;"><div data-drawio-colors="color: #34d399; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 14px; font-family: Helvetica; color: rgb(52, 211, 153); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">② Server Hello &amp; Certificate (发送：服务端随机数 Server_Random、数字证书[含公钥])</div></div></div></foreignObject><text x="440" y="284" fill="#34d399" font-family="&quot;Helvetica&quot;" font-size="14px" text-anchor="middle">② Server Hello &amp; Certificate (发送：服务端随机数 Server_Random、数字证书[含公钥])</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-106"><g><path d="M 740 300 L 147.3 300" fill="none" stroke="#10b981" stroke-width="1.5" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 141.68 300 L 149.18 296.25 L 147.3 300 L 149.18 303.75 Z" fill="#10b981" stroke="#10b981" stroke-width="1.5" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-107"><g><rect x="290" y="310" width="300" height="20" fill="none" stroke="none" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 298px; height: 1px; padding-top: 320px; margin-left: 291px;"><div data-drawio-colors="color: #fcd34d; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 13px; font-family: Helvetica; color: rgb(252, 211, 77); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">👁️ 路由器截获明文：Server_Random 及 服务器公钥</div></div></div></foreignObject><text x="440" y="324" fill="#fcd34d" font-family="&quot;Helvetica&quot;" font-size="13px" text-anchor="middle">👁️ 路由器截获明文：Server_Random 及 服务器公钥</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-108"><g><rect x="0" y="360" width="280" height="60" rx="9" ry="9" fill="#1e293b" stroke="#3b82f6" stroke-dasharray="3 3" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 278px; height: 1px; padding-top: 390px; margin-left: 1px;"><div data-drawio-colors="color: #93c5fd; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 13px; font-family: Helvetica; color: rgb(147, 197, 253); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">③ 客户端校验证书有效后，生成核心机密：<br />预主密钥 (Pre-Master Secret)<br />并使用刚才收到的【服务器公钥】将其加密</div></div></div></foreignObject><text x="140" y="394" fill="#93c5fd" font-family="&quot;Helvetica&quot;" font-size="13px" text-anchor="middle">③ 客户端校验证书有效后，生成核心机密：...</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-109"><g><rect x="190" y="450" width="500" height="20" fill="none" stroke="none" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 498px; height: 1px; padding-top: 460px; margin-left: 191px;"><div data-drawio-colors="color: #93c5fd; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 14px; font-family: Helvetica; color: rgb(147, 197, 253); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">④ Client Key Exchange (发送：被公钥加密后的 Pre-Master Secret)</div></div></div></foreignObject><text x="440" y="464" fill="#93c5fd" font-family="&quot;Helvetica&quot;" font-size="14px" text-anchor="middle">④ Client Key Exchange (发送：被公钥加密后的 Pre-Master Secret)</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-110"><g><path d="M 140 480 L 731.76 480" fill="none" stroke="#60a5fa" stroke-width="2" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 737.76 480 L 729.76 484 L 731.76 480 L 729.76 476 Z" fill="#60a5fa" stroke="#60a5fa" stroke-width="2" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-111"><g><rect x="240" y="495" width="400" height="20" fill="none" stroke="none" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 398px; height: 1px; padding-top: 505px; margin-left: 241px;"><div data-drawio-colors="color: #ef4444; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 14px; font-family: Helvetica; color: rgb(239, 68, 68); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: normal; overflow-wrap: normal;">⛔ 截获密文！路由器没有【服务器私钥】，绝对无法解密此报文！</div></div></div></foreignObject><text x="440" y="509" fill="#ef4444" font-family="&quot;Helvetica&quot;" font-size="14px" text-anchor="middle" font-weight="bold">⛔ 截获密文！路由器没有【服务器私钥】，绝对无法解密此报文！</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-112"><g><rect x="0" y="550" width="280" height="40" rx="6" ry="6" fill="#1e293b" stroke="#3b82f6" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 278px; height: 1px; padding-top: 570px; margin-left: 1px;"><div data-drawio-colors="color: #d1d5db; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(209, 213, 219); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">⑤ 计算最终会话密钥 (Session Key):<br />Client_Random + Server_Random + Pre-Master</div></div></div></foreignObject><text x="140" y="574" fill="#d1d5db" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">⑤ 计算最终会话密钥 (Session Key):...</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-113"><g><rect x="600" y="550" width="280" height="40" rx="6" ry="6" fill="#1e293b" stroke="#10b981" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 278px; height: 1px; padding-top: 570px; margin-left: 601px;"><div data-drawio-colors="color: #d1d5db; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(209, 213, 219); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">⑤ 用私钥解密得到 Pre-Master Secret，同理计算会话密钥:<br />Client_Random + Server_Random + Pre-Master</div></div></div></foreignObject><text x="740" y="574" fill="#d1d5db" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">⑤ 用私钥解密得到 Pre-Master Secret，同理计算会话密钥:...</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-114"><g><rect x="265" y="560" width="350" height="20" fill="none" stroke="none" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 348px; height: 1px; padding-top: 570px; margin-left: 266px;"><div data-drawio-colors="color: #ef4444; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 13px; font-family: Helvetica; color: rgb(239, 68, 68); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">✖ 路由器因无法获取 Pre-Master，无法合成 Session Key</div></div></div></foreignObject><text x="440" y="574" fill="#ef4444" font-family="&quot;Helvetica&quot;" font-size="13px" text-anchor="middle">✖ 路由器因无法获取 Pre-Master，无法合成 Session Key</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-115"><g><rect x="190" y="630" width="500" height="20" fill="none" stroke="none" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 498px; height: 1px; padding-top: 640px; margin-left: 191px;"><div data-drawio-colors="color: #fcd34d; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 15px; font-family: Helvetica; color: rgb(252, 211, 77); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: normal; overflow-wrap: normal;">⑥ HTTPS 加密通信阶段 (使用生成的 Session Key 进行对称加密传输)</div></div></div></foreignObject><text x="440" y="645" fill="#fcd34d" font-family="&quot;Helvetica&quot;" font-size="15px" text-anchor="middle" font-weight="bold">⑥ HTTPS 加密通信阶段 (使用生成的 Session Key 进行对称加密传输)</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-116"><g><path d="M 148.24 670 L 731.76 670" fill="none" stroke="#f59e0b" stroke-width="2" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 142.24 670 L 150.24 666 L 148.24 670 L 150.24 674 Z" fill="#f59e0b" stroke="#f59e0b" stroke-width="2" stroke-miterlimit="10" pointer-events="all"/><path d="M 737.76 670 L 729.76 674 L 731.76 670 L 729.76 666 Z" fill="#f59e0b" stroke="#f59e0b" stroke-width="2" stroke-miterlimit="10" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe flex-end; justify-content: unsafe center; width: 1px; height: 1px; padding-top: 662px; margin-left: 440px;"><div data-drawio-colors="color: #fcd34d; background-color: rgb(24, 20, 29); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 14px; font-family: Helvetica; color: rgb(252, 211, 77); line-height: 1.2; pointer-events: all; font-weight: bold; background-color: rgb(24, 20, 29); white-space: nowrap;">[ Application Data ]</div></div></div></foreignObject><text x="440" y="662" fill="#fcd34d" font-family="&quot;Helvetica&quot;" font-size="14px" text-anchor="middle" font-weight="bold">[ Application Data ]</text></switch></g></g></g><g data-cell-id="5DwtJKmxQQW1hQIWXWCG-117"><g><rect x="240" y="690" width="400" height="20" fill="none" stroke="none" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 398px; height: 1px; padding-top: 700px; margin-left: 241px;"><div data-drawio-colors="color: #ef4444; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 14px; font-family: Helvetica; color: rgb(239, 68, 68); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: normal; overflow-wrap: normal;">⛔ 路由器只能看到一堆乱码，无法窃听任何真实的业务数据！</div></div></div></foreignObject><text x="440" y="704" fill="#ef4444" font-family="&quot;Helvetica&quot;" font-size="14px" text-anchor="middle" font-weight="bold">⛔ 路由器只能看到一堆乱码，无法窃听任何真实的业务数据！</text></switch></g></g></g></g></g></g><switch><g requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"/><a transform="translate(0,-5)" xlink:href="https://www.drawio.com/doc/faq/svg-export-text-problems" target="_blank"><text text-anchor="middle" font-size="10px" x="50%" y="100%">Text is not SVG - cannot display</text></a></switch></svg>