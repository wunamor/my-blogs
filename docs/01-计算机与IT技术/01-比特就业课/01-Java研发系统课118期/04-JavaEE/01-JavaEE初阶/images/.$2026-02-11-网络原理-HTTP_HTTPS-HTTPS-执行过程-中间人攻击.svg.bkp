ica&quot;" font-size="15px" text-anchor="middle" font-weight="bold">被黑客入侵的网络设备&#xa;(路由器 / 抓包节点)</text></switch></g></g></g><g data-cell-id="UmpluuzXU1mWl0Q2IrnB-50"><g><rect x="730" y="50" width="160" height="60" rx="9" ry="9" fill="#064e3b" stroke="#10b981" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 158px; height: 1px; padding-top: 80px; margin-left: 731px;"><div data-drawio-colors="color: #d1d5db; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 16px; font-family: Helvetica; color: rgb(209, 213, 219); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: normal; overflow-wrap: normal;">服务器<br />(持有私钥)</div></div></div></foreignObject><text x="810" y="85" fill="#d1d5db" font-family="&quot;Helvetica&quot;" font-size="16px" text-anchor="middle" font-weight="bold">服务器&#xa;(持有私钥)</text></switch></g></g></g><g data-cell-id="UmpluuzXU1mWl0Q2IrnB-51"><g><path d="M 110 110 L 110 720" fill="none" stroke="#4b5563" stroke-width="1.5" stroke-miterlimit="10" stroke-dasharray="4.5 4.5" pointer-events="stroke"/></g></g><g data-cell-id="UmpluuzXU1mWl0Q2IrnB-52"><g><path d="M 460 110 L 460 720" fill="none" stroke="#ef4444" stroke-width="1.5" stroke-miterlimit="10" stroke-dasharray="4.5 4.5" pointer-events="stroke"/></g></g><g data-cell-id="UmpluuzXU1mWl0Q2IrnB-53"><g><path d="M 810 110 L 810 720" fill="none" stroke="#4b5563" stroke-width="1.5" stroke-miterlimit="10" stroke-dasharray="4.5 4.5" pointer-events="stroke"/></g></g><g data-cell-id="UmpluuzXU1mWl0Q2IrnB-54"><g><rect x="120" y="700" width="50" height="20" fill="none" stroke="none" pointer-events="all"/></g><g>