<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" width="921px" height="722px" viewBox="-0.5 -0.5 921 722" content="&lt;mxfile host=&quot;Electron&quot; agent=&quot;Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/24.7.8 Chrome/128.0.6613.36 Electron/32.0.1 Safari/537.36&quot; version=&quot;24.7.8&quot;&gt;&#10;  &lt;diagram id=&quot;VoOxtT2WnXROTpNbEF2W&quot; name=&quot;第 1 页&quot;&gt;&#10;    &lt;mxGraphModel dx=&quot;1105&quot; dy=&quot;654&quot; grid=&quot;1&quot; gridSize=&quot;10&quot; guides=&quot;1&quot; tooltips=&quot;1&quot; connect=&quot;1&quot; arrows=&quot;1&quot; fold=&quot;1&quot; page=&quot;1&quot; pageScale=&quot;1&quot; pageWidth=&quot;900&quot; pageHeight=&quot;700&quot; background=&quot;#121212&quot; math=&quot;0&quot; shadow=&quot;1&quot;&gt;&#10;      &lt;root&gt;&#10;        &lt;mxCell id=&quot;0&quot; /&gt;&#10;        &lt;mxCell id=&quot;1&quot; parent=&quot;0&quot; /&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-47&quot; value=&quot;HTTPS 加密请求转发过程 (分段演示)&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#e5e7eb;fontStyle=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;240&quot; y=&quot;40&quot; width=&quot;600&quot; height=&quot;40&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-48&quot; value=&quot;客户端&amp;#xa;(持有公钥)&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#3b82f6;fontColor=#d1d5db;fontSize=16;fontStyle=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;110&quot; y=&quot;90&quot; width=&quot;160&quot; height=&quot;60&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-49&quot; value=&quot;被黑客入侵的网络设备&amp;#xa;(路由器 / 抓包节点)&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#ef4444;fontColor=#fca5a5;fontSize=15;fontStyle=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;440&quot; y=&quot;90&quot; width=&quot;200&quot; height=&quot;60&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-50&quot; value=&quot;服务器&amp;#xa;(持有私钥)&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;fontColor=#d1d5db;fontSize=16;fontStyle=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;810&quot; y=&quot;90&quot; width=&quot;160&quot; height=&quot;60&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-51&quot; style=&quot;endArrow=none;html=1;strokeColor=#4b5563;strokeWidth=1.5;dashed=1;&quot; edge=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;190&quot; y=&quot;150&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;190&quot; y=&quot;760&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-52&quot; style=&quot;endArrow=none;html=1;strokeColor=#ef4444;strokeWidth=1.5;dashed=1;&quot; edge=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;540&quot; y=&quot;150&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;540&quot; y=&quot;760&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-53&quot; style=&quot;endArrow=none;html=1;strokeColor=#4b5563;strokeWidth=1.5;dashed=1;&quot; edge=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;890&quot; y=&quot;150&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;890&quot; y=&quot;760&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-54&quot; value=&quot;Time ↓&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#9ca3af;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;200&quot; y=&quot;740&quot; width=&quot;50&quot; height=&quot;20&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-55&quot; value=&quot;Time ↓&quot; style=&quot;text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#9ca3af;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;900&quot; y=&quot;740&quot; width=&quot;50&quot; height=&quot;20&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-56&quot; value=&quot;决定对称密钥 (如: 888888)&amp;#xa;并使用【公钥】将其加密&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#3b82f6;fontColor=#93c5fd;fontSize=13;align=center;dashed=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;80&quot; y=&quot;180&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-57&quot; value=&quot;密文请求 (包含加密的 888888)&quot; style=&quot;edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=1.5;fontColor=#93c5fd;fontSize=14;fontStyle=1;align=center;verticalAlign=bottom;spacingBottom=5;endArrow=classic;&quot; edge=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;190&quot; y=&quot;280&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;540&quot; y=&quot;280&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-58&quot; value=&quot;密文请求 (包含加密的 888888)&quot; style=&quot;edgeStyle=none;html=1;strokeColor=#60a5fa;strokeWidth=1.5;fontColor=#93c5fd;fontSize=14;fontStyle=1;align=center;verticalAlign=bottom;spacingBottom=5;endArrow=classic;&quot; edge=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;540&quot; y=&quot;280&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;890&quot; y=&quot;280&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-59&quot; value=&quot;⛔ 截获密文请求，但【黑客没有私钥】&amp;#xa;绝对无法解密获取 888888，只能原样转发&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#450a0a;strokeColor=#ef4444;fontColor=#fca5a5;fontSize=13;align=center;dashed=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;400&quot; y=&quot;310&quot; width=&quot;280&quot; height=&quot;50&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-60&quot; value=&quot;通过【私钥】解密密文&amp;#xa;成功获取对称密钥是 888888&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#10b981;fontColor=#34d399;fontSize=13;align=center;dashed=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;780&quot; y=&quot;330&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-61&quot; value=&quot;密文响应，使用 888888 加密&quot; style=&quot;edgeStyle=none;html=1;strokeColor=#10b981;strokeWidth=1.5;fontColor=#34d399;fontSize=14;fontStyle=1;align=center;verticalAlign=bottom;spacingBottom=5;endArrow=classic;&quot; edge=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;890&quot; y=&quot;430&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;540&quot; y=&quot;430&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-62&quot; value=&quot;密文响应，使用 888888 加密&quot; style=&quot;edgeStyle=none;html=1;strokeColor=#10b981;strokeWidth=1.5;fontColor=#34d399;fontSize=14;fontStyle=1;align=center;verticalAlign=bottom;spacingBottom=5;endArrow=classic;&quot; edge=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;540&quot; y=&quot;430&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;190&quot; y=&quot;430&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-63&quot; value=&quot;⛔ 截获密文响应，依然没有 888888 密钥&amp;#xa;无法解密业务数据&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#450a0a;strokeColor=#ef4444;fontColor=#fca5a5;fontSize=13;align=center;dashed=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;400&quot; y=&quot;460&quot; width=&quot;280&quot; height=&quot;50&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-64&quot; value=&quot;后续密文请求 (对称加密)&quot; style=&quot;edgeStyle=none;html=1;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#fcd34d;fontSize=14;fontStyle=1;align=center;verticalAlign=bottom;spacingBottom=5;endArrow=classic;&quot; edge=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;190&quot; y=&quot;560&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;540&quot; y=&quot;560&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-65&quot; value=&quot;后续密文请求 (对称加密)&quot; style=&quot;edgeStyle=none;html=1;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#fcd34d;fontSize=14;fontStyle=1;align=center;verticalAlign=bottom;spacingBottom=5;endArrow=classic;&quot; edge=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;540&quot; y=&quot;560&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;890&quot; y=&quot;560&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-66&quot; value=&quot;后续密文响应 (对称加密)&quot; style=&quot;edgeStyle=none;html=1;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#fcd34d;fontSize=14;fontStyle=1;align=center;verticalAlign=bottom;spacingBottom=5;endArrow=classic;&quot; edge=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;890&quot; y=&quot;640&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;540&quot; y=&quot;640&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;UmpluuzXU1mWl0Q2IrnB-67&quot; value=&quot;后续密文响应 (对称加密)&quot; style=&quot;edgeStyle=none;html=1;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#fcd34d;fontSize=14;fontStyle=1;align=center;verticalAlign=bottom;spacingBottom=5;endArrow=classic;&quot; edge=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot;&gt;&#10;            &lt;mxPoint x=&quot;540&quot; y=&quot;640&quot; as=&quot;sourcePoint&quot; /&gt;&#10;            &lt;mxPoint x=&quot;190&quot; y=&quot;640&quot; as=&quot;targetPoint&quot; /&gt;&#10;          &lt;/mxGeometry&gt;&#10;        &lt;/mxCell&gt;&#10;      &lt;/root&gt;&#10;    &lt;/mxGraphModel&gt;&#10;  &lt;/diagram&gt;&#10;&lt;/mxfile&gt;&#10;" style="background-color: rgb(18, 18, 18);"><defs/><rect fill="#121212" width="100%" height="100%" x="0" y="0"/><g><g data-cell-id="0"><g data-cell-id="1"><g data-cell-id="UmpluuzXU1mWl0Q2IrnB-47"><g><rect x="160" y="0" width="600" height="40" fill="none" stroke="none" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 598px; height: 1px; padding-top: 20px; margin-left: 161px;"><div data-drawio-colors="color: #e5e7eb; " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 22px; font-family: Helvetica; color: rgb(229, 231, 235); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: normal; overflow-wrap: normal;">HTTPS 加密请求转发过程 (分段演示)</div></div></div></foreignObject><text x="460" y="27" fill="#e5e7eb" font-family="&quot;Helvetica&quot;" font-size="22px" text-anchor="middle" font-weight="bold">HTTPS 加密请求转发过程 (分段演示)</text></switch></g></g></g><g data-cell-id="UmpluuzXU1mWl0Q2IrnB-48"><g><rect x="30" y="50" width="160" height="60" rx="9" ry="9" fill="#1e3a8a" stroke="#3b